# Replace the hostname only on the owner-controlled HTTPS host.
# No request/access logs, and operational logs are discarded to avoid raw IP logs.
{
    log {
        output discard
    }
}
stats.example.com {
    handle /v1/usage {
        reverse_proxy 127.0.0.1:8080
    }
    handle {
        respond 404
    }
}
