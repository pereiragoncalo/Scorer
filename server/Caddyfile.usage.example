# Optional direct HTTPS instead of existing Cloudflare Tunnel. No access logs.
{
    log {
        output discard
    }
}
stats.example.com {
    @service path /health /admin /v1/usage /v1/totals /v1/leaderboard /v1/leaderboard/withdraw /v2/records /v2/records/withdraw
    handle @service {
        reverse_proxy 127.0.0.1:8787
    }
    handle {
        respond 404
    }
}
