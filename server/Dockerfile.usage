FROM python:3.12-slim
WORKDIR /app
COPY anonymous_stats.py season_records.py /app/
COPY server/usage_collector.py server/usage_digest.py server/session_notices.py server/leaderboard.py server/season_records.py server/dashboard.html /app/server/
RUN mkdir /data && chown 10001:10001 /data
USER 10001:10001
EXPOSE 8080
CMD ["python", "server/usage_collector.py", "--bind", "0.0.0.0", "--db", "/data/usage.sqlite"]
