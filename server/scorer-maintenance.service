[Unit]
Description=Scorer aggregate retention and private-data-free backup
After=scorer-online.service
[Service]
Type=oneshot
User=scorer
WorkingDirectory=/opt/scorer
ExecStart=/usr/bin/python3 -m server.maintenance --db /var/lib/scorer/online.sqlite
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/scorer
